#!/bin/sh
# Launches `mojave mcp`, the MCP server built into the Mojave CLI. Apps that
# start Claude Code from a GUI often have a shorter PATH than a login shell,
# so look in the install script's default locations too.
for m in "$(command -v mojave 2>/dev/null)" "$HOME/.local/bin/mojave" /usr/local/bin/mojave /opt/homebrew/bin/mojave; do
  if [ -n "$m" ] && [ -x "$m" ]; then
    # `mcp` arrived in a 2026-10 CLI; an older binary would print its usage
    # onto the JSON-RPC channel instead.
    if ! "$m" help 2>/dev/null | grep -q '^  mcp '; then
      echo "mojave-mcp: $m predates \`mojave mcp\`; run \`mojave update\`" >&2
      exit 1
    fi
    exec "$m" mcp
  fi
done
echo "mojave-mcp: the Mojave CLI is not installed. Install it with:" >&2
echo "  curl -fsSL https://mojave.sh/install.sh | sh && mojave login" >&2
exit 1
